---
import BaseLayout from '../layouts/BaseLayout.astro'
import { GameProductPage } from '../views/GameProductPage'
import { SEO, SITE_URL } from '../data/site'
import { productDetailJsonLd, productJsonLdDocument } from '../lib/seo'
import { getGame } from '../data/games'

const game = getGame('wardogs')
const productJsonLd = productJsonLdDocument(productDetailJsonLd(game?.status ?? 'Updating'))
const jsonLdExtra = [
  {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: `${SITE_URL}/` },
      {
        '@type': 'ListItem',
        position: 2,
        name: 'Wardogs Cheats',
        item: `${SITE_URL}/wardogs-hacks`,
      },
    ],
  },
]
---

<BaseLayout seo={SEO.product} jsonLdExtra={jsonLdExtra} productJsonLd={productJsonLd}>
  <GameProductPage client:idle guideSlug="wardogs-hacks" />
</BaseLayout>


